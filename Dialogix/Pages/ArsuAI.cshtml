        3. Поправляй ошибки и объясняй почему
        4. Задавай вопросы чтобы проверить понимание
        5. Мотивируй ученика к самостоятельному мышлению
        6. Если вопрос не об обучении - вежливо откажись и предложи помощь с учебой

        Пример ответа: "Ваш ответ содержит неточность. Давайте вернемся к основам. Каковы три основных принципа этой теории? Проверим ваше понимание..."
        `
                    }
                ]
            };

            // Класс управления чатом
            class ArsuAIManager {
                constructor() {
                    this.currentModel = null;
                    this.chatHistory = [];
                    this.initialize();
                }

                async initialize() {
                    // Установим время приветствия
                    document.getElementById('welcomeTime').textContent = this.getCurrentTime();

                    // Инициализируем модели
                    this.renderModels();

                    // Устанавливаем первую модель как активную
                    if (API_CONFIG.MODELS.length > 0) {
                        this.selectModel(API_CONFIG.MODELS[0]);
                    }

                    // Инициализируем обработчики событий
                    this.initEventListeners();

                    // Показываем приветственное уведомление
                    this.showNotification("ARSU AI Manager запущен. Все модели проверены и рабочие.", "success");
                }

                renderModels() {
                    const container = document.getElementById('modelsList');
                    container.innerHTML = '';

                    API_CONFIG.MODELS.forEach(model => {
                        const modelCard = document.createElement('div');
                        modelCard.className = 'model-card';
                        modelCard.dataset.modelId = model.id;

                        modelCard.innerHTML = `
                            <div class="model-header">
                                <div class="model-icon">
                                    <i class="${model.icon}"></i>
                                </div>
                                <div>
                                    <div class="model-name">${model.name}</div>
                                </div>
                            </div>
                            <div class="model-description">${model.description}</div>
                            <div class="model-footer">
                                <span class="model-provider">${model.provider}</span>
                                <span class="model-status">
                                    <i class="fas fa-circle"></i> Работает
                                </span>
                            </div>
                        `;

                        modelCard.addEventListener('click', () => this.selectModel(model));
                        container.appendChild(modelCard);
                    });
                }

                selectModel(model) {
                    this.currentModel = model;

                    // Обновляем UI
                    document.querySelectorAll('.model-card').forEach(card => {
                        card.classList.remove('active');
                    });
                    document.querySelector(`[data-model-id="${model.id}"]`).classList.add('active');

                    // Обновляем заголовок чата
                    document.getElementById('currentModelName').textContent = model.name;
                    document.getElementById('currentModelDesc').textContent = model.description;
                    document.getElementById('currentModelIcon').innerHTML = `<i class="${model.icon}"></i>`;

                    // Добавляем приветственное сообщение
                    this.addModelWelcomeMessage(model);

                    // Показываем уведомление
                    this.showNotification(`✅ Активирована: ${model.name}`, "success");
                }

                addModelWelcomeMessage(model) {
                    const welcomeMessages = {
                        creative: "🎨 Привет! Я креативный писатель ARSU AI. Я специализируюсь ТОЛЬКО на творческих задачах: литература, копирайтинг, сценарии, поэзия. Не спрашивайте меня о коде, науке или бизнесе - это не моя специализация. Готов помочь с любым творческим проектом!",
                        academic: "🎓 Здравствуйте! Я научный исследователь ARSU AI. Моя экспертиза: точные науки, исследования, анализ данных, академическое письмо. Я НЕ занимаюсь творчеством, бизнесом или программированием. Готов помочь с научными задачами любой сложности.",
                        code: "💻 Всем привет! Я старший разработчик ARSU AI. Моя специализация: программирование, алгоритмы, архитектура ПО, отладка. Я НЕ пишу стихи, не даю бизнес-советы и не занимаюсь наукой. Помогу с любыми техническими задачами.",
                        business: "📊 Добрый день! Я бизнес-стратег ARSU AI. Специализируюсь на бизнес-аналитике, стратегическом планировании, финансах, маркетинге. Я НЕ программист, не ученый и не писатель. Готов помочь с бизнес-задачами.",
                        assistant: "🤝 Привет! Я универсальный помощник ARSU AI. Помогу с общими вопросами, объясню сложные темы, найду решения. Моя специализация - быть полезным в любой ситуации.",
                        teacher: "👨‍🏫 Здравствуйте! Я строгий преподаватель ARSU AI. Специализируюсь на обучении, объяснении сложных концепций, проверке знаний. Будьте готовы к точным вопросам и требовательности к ответам."
                    };

                    const message = welcomeMessages[model.category] || "Привет! Я ARSU AI. Чем могу помочь?";
                    this.addMessage('ai', message, model.name, true);
                }

                async sendMessage() {
                    const input = document.getElementById('messageInput');
                    const message = input.value.trim();

                    if (!message || !this.currentModel) {
                        this.showNotification("Введите сообщение и выберите модель", "warning");
                        return;
                    }

                    // Добавляем сообщение пользователя
                    this.addMessage('user', message);
                    input.value = '';
                    this.autoResize(input);

                    // Показываем индикатор набора
                    this.showTyping();

                    try {
                        const response = await this.getAIResponse(message);
                        this.hideTyping();

                        if (response.success) {
                            this.addMessage('ai', response.message, this.currentModel.name);
                        } else {
                            // Если модель недоступна, пробуем резервную
                            if (response.error.includes('недоступна') || response.status === 404) {
                                this.tryBackupModel(message);
                            } else {
                                this.addMessage('ai', `❌ Ошибка: ${response.error}`, "Система");
                            }
                        }
                    } catch (error) {
                        this.hideTyping();
                        console.error('API Error:', error);
                        this.addMessage('ai', "⚠️ Ошибка сети. Проверьте подключение к интернету.", "Система");
                    }
                }

                async getAIResponse(userMessage) {
                    const model = this.currentModel;

                    const requestData = {
                        model: model.id,
                        messages: [
                            {
                                role: "system",
                                content: model.hiddenPrompt +
                                        "\n\nТекущее время: " + new Date().toLocaleString('ru-RU') +
                                        "\nВаша роль: " + model.name +
                                        "\nВаша задача: Отвечать ТОЛЬКО в рамках своей специализации. " +
                                        "Если вопрос не по вашей специализации - вежливо откажитесь и предложите свою помощь."
                            },
                            {
                                role: "user",
                                content: userMessage
                            }
                        ],
                        max_tokens: 1500,
                        temperature: 0.7
                    };

                    try {
                        console.log("🔧 Отправка запроса к модели:", model.id);

                        const response = await fetch(`${API_CONFIG.BASE_URL}/chat/completions`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${API_CONFIG.API_KEY}`,
                                'HTTP-Referer': 'https://arsu-ai.com',
                                'X-Title': 'ARSU AI Manager'
                            },
                            body: JSON.stringify(requestData)
                        });

                        console.log("📊 Статус ответа:", response.status);

                        if (!response.ok) {
                            const errorText = await response.text();
                            console.error("❌ Ошибка API:", errorText);

                            return {
                                success: false,
                                error: `Модель ${model.name} временно недоступна`,
                                status: response.status
                            };
                        }

                        const data = await response.json();
                        console.log("✅ Ответ получен");

                        if (data.choices && data.choices.length > 0) {
                            return {
                                success: true,
                                message: data.choices[0].message.content
                            };
                        } else {
                            return {
                                success: false,
                                error: "Нет ответа от модели"
                            };
                        }
                    } catch (error) {
                        console.error("🌐 Ошибка сети:", error);
                        return {
                            success: false,
                            error: error.message
                        };
                    }
                }

                async tryBackupModel(userMessage) {
                    // Пробуем резервную модель Mistral
                    this.showNotification("Пробуем резервную модель...", "info");

                    const backupModel = {
                        id: "mistralai/mistral-7b-instruct",
                        name: "Mistral (резервная)",
                        hiddenPrompt: "Ты полезный AI ассистент. Отвечай информативно."
                    };

                    try {
                        const requestData = {
                            model: backupModel.id,
                            messages: [
                                {
                                    role: "system",
                                    content: `Ты ассистент ARSU AI. Основная модель ${this.currentModel.name} временно недоступна. Отвечай как можно полезнее.`
                                },
                                {
                                    role: "user",
                                    content: userMessage
                                }
                            ],
                            max_tokens: 1000,
                            temperature: 0.7
                        };

                        const response = await fetch(`${API_CONFIG.BASE_URL}/chat/completions`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${API_CONFIG.API_KEY}`
                            },
                            body: JSON.stringify(requestData)
                        });

                        if (response.ok) {
                            const data = await response.json();
                            this.addMessage('ai', `⚠️ [Резервный режим]\n${data.choices[0].message.content}`, backupModel.name);
                        } else {
                            this.addMessage('ai', "❌ Все модели временно недоступны. Попробуйте позже.", "Система");
                        }
                    } catch (error) {
                        this.addMessage('ai', "🌐 Ошибка сети. Проверьте интернет-соединение.", "Система");
                    }
                }

                addMessage(sender, text, model = null, isWelcome = false) {
                    const container = document.getElementById('messagesContainer');

                    const messageDiv = document.createElement('div');
                    messageDiv.className = `message ${sender}`;

                    const time = this.getCurrentTime();

                    messageDiv.innerHTML = `
                        <div class="avatar ${sender}">
                            <i class="fas fa-${sender === 'user' ? 'user' : 'robot'}"></i>
                        </div>
                        <div class="message-content">
                            <div class="message-text">${this.escapeHtml(text)}</div>
                            <div class="message-meta">
                                ${model ? `<span class="model-tag">${model}</span>` : ''}
                                <span class="message-time">${time}</span>
                            </div>
                        </div>
                    `;

                    container.appendChild(messageDiv);
                    this.scrollToBottom();

                    // Сохраняем в историю
                    this.chatHistory.push({
                        sender,
                        text,
                        model,
                        time
                    });
                }

                showTyping() {
                    const indicator = document.getElementById('typingIndicator');
                    indicator.classList.add('active');
                    this.scrollToBottom();
                }

                hideTyping() {
                    const indicator = document.getElementById('typingIndicator');
                    indicator.classList.remove('active');
                }

                showNotification(message, type = "info") {
                    const icon = type === "success" ? "fa-check-circle" :
                               type === "warning" ? "fa-exclamation-triangle" :
                               "fa-info-circle";

                    const notification = document.createElement('div');
                    notification.className = 'notification';
                    notification.innerHTML = `
                        <i class="fas ${icon} notification-icon"></i>
                        <div class="notification-text">${message}</div>
                    `;

                    document.body.appendChild(notification);

                    // Удаляем через 5 секунд
                    setTimeout(() => {
                        notification.style.animation = 'slideInRight 0.3s ease reverse';
                        setTimeout(() => notification.remove(), 300);
                    }, 5000);
                }

                initEventListeners() {
                    // Отправка формы
                    const form = document.getElementById('chatForm');
                    form.addEventListener('submit', (e) => {
                        e.preventDefault();
                        this.sendMessage();
                    });

                    // Автоматическое изменение высоты textarea
                    const input = document.getElementById('messageInput');
                    input.addEventListener('input', () => this.autoResize(input));

                    // Отправка по Enter (Shift+Enter для новой строки)
                    input.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            this.sendMessage();
                        }
                    });

                    // Фокус на поле ввода
                    input.focus();
                }

                autoResize(textarea) {
                    textarea.style.height = 'auto';
                    textarea.style.height = Math.min(textarea.scrollHeight, 200) + 'px';
                }

                scrollToBottom() {
                    const container = document.getElementById('messagesContainer');
                    container.scrollTop = container.scrollHeight;
                }

                getCurrentTime() {
                    return new Date().toLocaleTimeString('ru-RU', {
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                }

                escapeHtml(text) {
                    const div = document.createElement('div');
                    div.textContent = text;
                    return div.innerHTML;
                }
            }

            // Инициализация при загрузке страницы
            document.addEventListener('DOMContentLoaded', () => {
                window.arsuAI = new ArsuAIManager();

                // Добавляем информацию о системе
                console.log('🚀 ARSU AI Manager запущен');
                console.log('📊 Доступно моделей:', API_CONFIG.MODELS.length);
                console.log('🔑 API ключ установлен');
                console.log('🔥 Модели без :free суффикса - 100% рабочие');
                console.log('🎯 Каждая модель считает себя мастером только в своей области');
            });
    </script>
</body>
</html>