<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARSU AI Manager - Мультимодельная система</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
            color: #ffffff;
            min-height: 100vh;
            line-height: 1.6;
        }

        /* Контейнер */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Заголовок */
        .header {
            text-align: center;
            padding: 40px 20px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 24px;
            margin-bottom: 40px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
        }

        .logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .logo-icon {
            font-size: 48px;
            background: linear-gradient(135deg, #7c3aed, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo-text {
            font-size: 42px;
            font-weight: 800;
            background: linear-gradient(135deg, #7c3aed, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .tagline {
            color: #94a3b8;
            font-size: 18px;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Основной контент */
        .main-content {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 30px;
            min-height: 70vh;
        }

  

        /* Панель моделей */
        .models-panel {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
        }

        .panel-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 25px;
            color: #e2e8f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .panel-title i {
                color: #8b5cf6;
            }

        /* Карточки моделей */
        .model-card {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .model-card:hover {
                background: rgba(255, 255, 255, 0.08);
                border-color: rgba(139, 92, 246, 0.4);
                transform: translateY(-2px);
            }

            .model-card.active {
                background: rgba(139, 92, 246, 0.15);
                border-color: #8b5cf6;
                box-shadow: 0 10px 30px rgba(139, 92, 246, 0.2);
            }

        .model-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 10px;
        }

        .model-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #7c3aed, #3b82f6);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: white;
        }

        .model-name {
            font-size: 18px;
            font-weight: 600;
            color: #f1f5f9;
        }

        .model-description {
            font-size: 14px;
            color: #94a3b8;
            margin-bottom: 15px;
        }

        .model-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
        }

        .model-provider {
            color: #cbd5e1;
            background: rgba(255, 255, 255, 0.1);
            padding: 4px 12px;
            border-radius: 20px;
        }

        .model-status {
            color: #10b981;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .model-status i {
                font-size: 12px;
            }

        /* Область чата */
        .chat-area {
            display: flex;
            flex-direction: column;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            overflow: hidden;
        }

        /* Заголовок чата */
        .chat-header {
            padding: 25px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(255, 255, 255, 0.02);
        }

        .current-model-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .current-model-icon {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #7c3aed, #3b82f6);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .model-details h3 {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 5px;
            color: #f1f5f9;
        }

        .model-specs {
            color: #94a3b8;
            font-size: 14px;
        }

        /* История сообщений */
        .chat-messages {
            flex: 1;
            padding: 25px;
            overflow-y: auto;
            max-height: 500px;
        }

        .message {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
            animation: slideIn 0.3s ease;
        }

        {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .message.user {
            flex-direction: row-reverse;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

            .avatar.user {
                background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            }

            .avatar.ai {
                background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            }

        .message-content {
            max-width: 70%;
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: 18px;
            position: relative;
        }

        .message.user .message-content {
            background: rgba(59, 130, 246, 0.2);
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

        .message-text {
            line-height: 1.6;
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .message-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 13px;
            color: #94a3b8;
        }

        .message-time {
            font-family: 'Courier New', monospace;
        }

        .model-tag {
            background: rgba(139, 92, 246, 0.2);
            color: #a78bfa;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

        /* Индикатор набора */
        .typing-indicator {
            display: none;
            align-items: center;
            gap: 15px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 18px;
            margin: 0 25px 20px;
            animation: slideIn 0.3s ease;
        }

            .typing-indicator.active {
                display: flex;
            }

        .typing-dots {
            display: flex;
            gap: 6px;
        }

            .typing-dots span {
                width: 8px;
                height: 8px;
                background: #94a3b8;
                border-radius: 50%;
                animation: typing 1.4s infinite both;
            }

                .typing-dots span:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .typing-dots span:nth-child(3) {
                    animation-delay: 0.4s;
                }

        40% {
            transform: scale(1);
            opacity: 1;
        }

        }

        /* Форма ввода */
        .input-area {
            padding: 25px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(255, 255, 255, 0.02);
        }

        .chat-form {
            position: relative;
        }

        .chat-input {
            width: 100%;
            padding: 20px 24px;
            padding-right: 120px;
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            color: white;
            font-size: 16px;
            font-family: inherit;
            resize: none;
            min-height: 60px;
            max-height: 200px;
            transition: border-color 0.3s ease;
        }

            .chat-input:focus {
                outline: none;
                border-color: #8b5cf6;
            }

            .chat-input::placeholder {
                color: rgba(255, 255, 255, 0.4);
            }

        .input-actions {
            position: absolute;
            right: 20px;
            bottom: 20px;
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .send-btn {
            background: linear-gradient(135deg, #7c3aed, #3b82f6);
            color: white;
            border: none;
            width: 48px;
            height: 48px;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: all 0.3s ease;
        }

            .send-btn:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4);
            }

            .send-btn:disabled {
                opacity: 0.5;
                cursor: not-allowed;
                transform: none;
            }

        /* Уведомления */
        .notification {
            position: fixed;
            top: 30px;
            right: 30px;
            background: rgba(30, 41, 59, 0.95);
            border: 1px solid rgba(139, 92, 246, 0.3);
            border-radius: 12px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(20px);
            z-index: 1000;
            animation: slideInRight 0.3s ease;
            max-width: 350px;
        }
  


        .notification-icon {
            color: #8b5cf6;
            font-size: 20px;
        }

        .notification-text {
            font-size: 14px;
            color: #e2e8f0;
        }

        /* Скроллбар */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 255, 255, 0.3);
            }


        .header {
            padding: 30px 15px;
        }

        .logo-text {
            font-size: 32px;
        }

        .chat-messages {
            padding: 15px;
            max-height: 400px;
        }

        .message-content {
            max-width: 85%;
        }

        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Заголовок -->
        <header class="header">
            <div class="logo">
                <i class="fas fa-brain logo-icon"></i>
                <h1 class="logo-text">ARSU AI Manager</h1>
            </div>
            <p class="tagline">Мультимодельная система искусственного интеллекта для специализированных задач</p>
        </header>

        <!-- Основной контент -->
        <div class="main-content">
            <!-- Панель выбора моделей -->
            <div class="models-panel">
                <h3 class="panel-title">
                    <i class="fas fa-microchip"></i>
                    Доступные модели
                </h3>

                <div id="modelsList">
                    <!-- Модели будут загружены через JavaScript -->
                </div>
            </div>

            <!-- Область чата -->
            <div class="chat-area">
                <!-- Заголовок чата -->
                <div class="chat-header">
                    <div class="current-model-info">
                        <div class="current-model-icon" id="currentModelIcon">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div class="model-details">
                            <h3 id="currentModelName">Выберите модель AI</h3>
                            <div class="model-specs" id="currentModelDesc">
                                Выберите специализированную модель для начала работы
                            </div>
                        </div>
                    </div>
                </div>

                <!-- История сообщений -->
                <div class="chat-messages" id="messagesContainer">
                    <div class="message ai">
                        <div class="avatar ai">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div class="message-content">
                            <div class="message-text">
                                🚀 Добро пожаловать в <strong>ARSU AI Manager</strong>!<br><br>
                                Я - мультимодельная система искусственного интеллекта.<br>
                                Выберите одну из специализированных моделей слева для начала диалога.<br><br>
                                Каждая модель имеет уникальную специализацию и "скрытый промпт",<br>
                                который определяет её поведение и стиль ответов.
                            </div>
                            <div class="message-meta">
                                <span class="model-tag">Системное приветствие</span>
                                <span class="message-time" id="welcomeTime"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Индикатор набора -->
                <div class="typing-indicator" id="typingIndicator">
                    <div class="avatar ai">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div class="typing-content">
                        <div class="message-text">ARSU AI генерирует ответ...</div>
                        <div class="typing-dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                </div>

                <!-- Форма ввода -->
                <div class="input-area">
                    <form class="chat-form" id="chatForm">
                        <textarea class="chat-input"
                                  id="messageInput"
                                  placeholder="Введите ваше сообщение... (Enter для отправки, Shift+Enter для новой строки)"
                                  rows="1"></textarea>
                        <div class="input-actions">
                            <button type="submit" class="send-btn" id="sendBtn">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
            // 🔥 ГАРАНТИРОВАННО РАБОЧИЕ МОДЕЛИ OPENROUTER (без :free суффикса!)
