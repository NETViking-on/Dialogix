<script>
    // Глобальные переменные
    let currentModel = 'creative';

    document.addEventListener('DOMContentLoaded', function() {
        // Инициализация всех компонентов
        initSidebar();
        initModelSwitcher();
        initChatInterface();
        initQuickActions();
        startSystemMetricsSimulation();
        startSystemNotifications();

        // Добавляем скрытое поле для модели в форму
        addHiddenModelField();
    });

    function addHiddenModelField() {
        const chatForm = document.getElementById('chatForm');
        const hiddenInput = document.createElement('input');
        hiddenInput.type = 'hidden';
        hiddenInput.name = 'SelectedModel';
        hiddenInput.id = 'selectedModel';
        hiddenInput.value = currentModel;
        chatForm.appendChild(hiddenInput);
    }

    function initSidebar() {
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.querySelector('.sidebar');
        const navItems = document.querySelectorAll('.nav-item[data-model]');

        sidebarToggle.addEventListener('click', function() {
            sidebar.classList.toggle('open');
        });

        navItems.forEach(item => {
            item.addEventListener('click', function() {
                // Убираем активный класс у всех элементов
                navItems.forEach(nav => nav.classList.remove('active'));
                // Добавляем активный класс текущему элементу
                this.classList.add('active');

                const model = this.getAttribute('data-model');
                switchModel(model);
            });
        });
    }

    function initModelSwitcher() {
        const compactSwitch = document.getElementById('compactModelSwitch');
        const modelModal = document.getElementById('modelModal');
        const modalClose = document.getElementById('modalClose');
        const confirmSwitch = document.getElementById('confirmModelSwitch');
        const modelCards = document.querySelectorAll('.model-card');

        compactSwitch.addEventListener('click', function() {
            modelModal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        });

        modalClose.addEventListener('click', closeModal);
        confirmSwitch.addEventListener('click', closeModal);

        modelCards.forEach(card => {
            card.addEventListener('click', function() {
                modelCards.forEach(c => c.classList.remove('active'));
                this.classList.add('active');
            });
        });

        function closeModal() {
            modelModal.style.display = 'none';
            document.body.style.overflow = 'auto';

            const activeCard = document.querySelector('.model-card.active');
            if (activeCard) {
                const model = activeCard.getAttribute('data-model');
                switchModel(model);
            }
        }

        // Закрытие модального окна при клике вне его
        modelModal.addEventListener('click', function(e) {
            if (e.target === modelModal) {
                closeModal();
            }
        });
    }

    function switchModel(model) {
        if (model === currentModel) return;

        const loadingBar = document.getElementById('modelLoadingBar');
        const modelName = document.getElementById('modelName');
        const currentModelStatus = document.getElementById('currentModelStatus');
        const modelAvatar = document.getElementById('modelAvatar');
        const compactModelIcon = document.getElementById('compactModelIcon');
        const compactModelText = document.querySelector('.model-switch-text');
        const selectedModelInput = document.getElementById('selectedModel');

        // Показываем индикатор загрузки
        loadingBar.style.display = 'block';

        // Симуляция загрузки модели
        setTimeout(() => {
            const modelData = getModelData(model);

            // Обновляем интерфейс
            modelName.textContent = modelData.name;
            currentModelStatus.textContent = modelData.name;
            modelAvatar.innerHTML = `<i class="${modelData.icon}"></i>`;
            compactModelIcon.textContent = modelData.emoji;
            compactModelText.textContent = modelData.shortName;
            selectedModelInput.value = model;

            // Скрываем индикатор загрузки
            loadingBar.style.display = 'none';

            // Показываем уведомление о смене модели
            showNotification(`Модель изменена на: ${modelData.name}`, 'success');

            // Обновляем системные показатели
            updateSystemMetrics(model);

            // Добавляем приветственное сообщение от новой модели
            addModelWelcomeMessage(modelData);

            // Обновляем текущую модель
            currentModel = model;

        }, 1500);
    }

    function addModelWelcomeMessage(modelData) {
        const welcomeMessages = {
            creative: "Привет! Я Creative Writer - твой помощник в мире творчества и литературы. Готов помочь с написанием текстов, рассказов, стихов и любого креативного контента! Какие идеи у тебя есть? ✍️",
            math: "Здравствуйте! Я Math Genius, специалист по математике и анализу. Готов решать сложные задачи, объяснять концепции и помогать с вычислениями любой сложности! С какой математической проблемой столкнулись? 🧮",
            code: "Всем привет! Я Code Assistant - ваш напарник в программировании. Помогу с кодом, отладкой, архитектурой и обучением любым языкам программирования! Над каким проектом работаете? 💻",
            science: "Добро пожаловать! Я Science Pro, эксперт в научных дисциплинах. Готов помочь с исследованиями, анализом данных и объяснением сложных научных концепций! Какая тема вас интересует? 🔬",
            business: "Приветствую! Я Business AI, ваш консультант по бизнесу и аналитике. Помогу с стратегией, маркетингом, анализом данных и бизнес-планированием! Какой бизнес-вопрос хотите обсудить? 📊"
        };

        const message = welcomeMessages[modelData.shortName.toLowerCase()] || "Привет! Я готов к работе. Чем могу помочь?";

        // Создаем приветственное сообщение от бота
        const welcomeMessage = createBotMessage(message, modelData.name);

        // Добавляем сообщение в чат
        addMessageToChat(welcomeMessage);
    }

    function createBotMessage(text, modelName) {
        const messageDiv = document.createElement('div');
        messageDiv.className = 'message bot-message';
        messageDiv.innerHTML = `
            <div class="message-avatar">
                <div class="avatar-bot">
                    <i class="fas fa-robot"></i>
                </div>
            </div>
            <div class="message-content">
                <div class="message-header">
                    <span class="message-sender">${modelName}</span>
                    <span class="message-time">${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
                </div>
                <div class="message-text">${text}</div>
                <div class="message-footer">
                    <span class="message-model">${modelName}</span>
                </div>
            </div>
        `;
        return messageDiv;
    }

    function addMessageToChat(messageElement) {
        const messagesList = document.getElementById('messagesList');
        const emptyState = messagesList.querySelector('.chat-empty');

        // Убираем пустое состояние если оно есть
        if (emptyState) {
            emptyState.remove();
        }

        messagesList.appendChild(messageElement);
        scrollToBottom();

        // Добавляем анимацию появления
        messageElement.style.opacity = '0';
        messageElement.style.transform = 'translateY(20px)';

        setTimeout(() => {
            messageElement.style.transition = 'all 0.3s ease';
            messageElement.style.opacity = '1';
            messageElement.style.transform = 'translateY(0)';
        }, 10);
    }

    function scrollToBottom() {
        const chatBody = document.getElementById('chatBody');
        chatBody.scrollTop = chatBody.scrollHeight;
    }

    function getModelData(model) {
        const models = {
            creative: {
                name: 'Creative Writer',
                shortName: 'Creative',
                icon: 'fas fa-feather-alt',
                emoji: '📚'
            },
            math: {
                name: 'Math Genius',
                shortName: 'Math',
                icon: 'fas fa-square-root-alt',
                emoji: '🧮'
            },
            code: {
                name: 'Code Assistant',
                shortName: 'Code',
                icon: 'fas fa-code',
                emoji: '💻'
            },
            science: {
                name: 'Science Pro',
                shortName: 'Science',
                icon: 'fas fa-flask',
                emoji: '🔬'
            },
            business: {
                name: 'Business AI',
                shortName: 'Business',
                icon: 'fas fa-chart-line',
                emoji: '📊'
            }
        };

        return models[model] || models.creative;
    }

    function initChatInterface() {
        const chatInput = document.getElementById('UserInput');
        const sendButton = document.getElementById('sendButton');
        const typingIndicator = document.getElementById('typingIndicator');
        const newChatBtn = document.getElementById('newChatBtn');

        // Обработка отправки формы
        const chatForm = document.getElementById('chatForm');
        chatForm.addEventListener('submit', function(e) {
            e.preventDefault();
            sendMessage();
        });

        // Кнопка нового чата
        newChatBtn.addEventListener('click', function() {
            if (confirm('Очистить историю чата?')) {
                const messagesList = document.getElementById('messagesList');
                messagesList.innerHTML = '<div class="chat-empty"><div class="empty-icon">💬</div><p>No messages yet. Start a conversation with AI! 👋</p></div>';
                showNotification('Чат очищен', 'success');
            }
        });

        function sendMessage() {
            const message = chatInput.value.trim();
            if (!message) return;

            // Создаем и добавляем сообщение пользователя
            const userMessage = createUserMessage(message);
            addMessageToChat(userMessage);

            // Очищаем поле ввода
            chatInput.value = '';

            // Показываем индикатор набора
            typingIndicator.style.display = 'flex';
            scrollToBottom();

            // Симуляция ответа ИИ
            setTimeout(() => {
                typingIndicator.style.display = 'none';

                // Создаем ответ от ИИ
                const aiResponse = simulateAIResponse(message);
                const botMessage = createBotMessage(aiResponse, getModelData(currentModel).name);
                addMessageToChat(botMessage);

            }, 2000);
        }

        function createUserMessage(text) {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message user-message';
            messageDiv.innerHTML = `
                <div class="message-content">
                    <div class="message-header">
                        <span class="message-sender">Вы</span>
                        <span class="message-time">${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
                    </div>
                    <div class="message-text">${text}</div>
                </div>
                <div class="message-avatar">
                    <div class="avatar-user">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
            `;
            return messageDiv;
        }
    }

    function simulateAIResponse(message) {
        const responses = {
            creative: [
                "Как писатель с многолетним опытом, я вижу в вашем запросе прекрасную возможность для творческого развития. Позвольте мне предложить несколько идей для развития этой темы...",
                "О, это интересная тема для литературного произведения! Я могу помочь вам развить сюжет, создать персонажей или написать целый рассказ на основе вашей идеи.",
                "С точки зрения стилистики и композиции, ваш запрос открывает множество возможностей для креативной реализации. Давайте поработаем над этим вместе!"
            ],
            math: [
                "Проанализировав вашу задачу с математической точки зрения, я пришел к следующим выводам. Решение требует применения методов математического анализа и тщательного рассмотрения всех переменных.",
                "Используя методы математического анализа, мы можем решить эту задачу следующим образом. Рассмотрим сначала основные принципы, а затем перейдем к конкретным вычислениям.",
                "Рассмотрим вашу проблему через призму математической логики и получим оптимальное решение. Для начала определим ключевые переменные и условия задачи."
            ],
            code: [
                "С точки зрения архитектуры программного обеспечения, ваш код можно оптимизировать следующим образом. Рекомендую использовать более эффективные алгоритмы и улучшить структуру данных.",
                "Проанализировав ваш запрос, я предлагаю следующее решение. Этот подход обеспечит лучшую производительность и поддерживаемость кода в долгосрочной перспективе.",
                "Для реализации этой функциональности рекомендую использовать следующий алгоритм. Он обеспечивает оптимальную временную сложность и хорошо масштабируется."
            ],
            science: [
                "С научной точки зрения, ваш вопрос затрагивает интересные аспекты. Исходя из последних исследований в этой области, можно сделать следующие выводы...",
                "Проанализировав доступные научные данные, я могу сказать, что этот феномен объясняется следующими принципами. Давайте рассмотрим их подробнее.",
                "Основываясь на научном методе, мы можем подойти к решению этой проблемы систематически. Рассмотрим гипотезы, методы исследования и возможные выводы."
            ],
            business: [
                "С точки зрения бизнес-аналитики, ваша идея имеет хороший потенциал. Проведя SWOT-анализ, мы видим следующие возможности для развития и возможные риски.",
                "Для успешной реализации этого бизнес-проекта рекомендую рассмотреть следующие стратегические подходы. Они помогут максимизировать ROI и минимизировать риски.",
                "Проанализировав рыночные тенденции, я могу предложить следующие рекомендации для вашего бизнеса. Они основаны на актуальных данных и лучших практиках."
            ]
        };

        const modelResponses = responses[currentModel] || responses.creative;
        return modelResponses[Math.floor(Math.random() * modelResponses.length)];
    }

    function initQuickActions() {
        // Дополнительные быстрые действия можно добавить здесь
    }

    function startSystemMetricsSimulation() {
        setInterval(() => {
            // Обновляем случайные системные показатели
            const stats = document.querySelectorAll('.stat-progress');
            stats.forEach(stat => {
                const newWidth = Math.random() * 80 + 10;
                stat.style.width = newWidth + '%';
                stat.nextElementSibling.textContent = Math.round(newWidth) + '%';
            });
        }, 5000);
    }

    function updateSystemMetrics(model) {
        // Обновляем показатели в зависимости от выбранной модели
        const metrics = {
            creative: { cpu: 23, memory: 67, network: 12 },
            math: { cpu: 45, memory: 78, network: 8 },
            code: { cpu: 32, memory: 71, network: 15 },
            science: { cpu: 58, memory: 82, network: 6 },
            business: { cpu: 28, memory: 65, network: 18 }
        };

        const modelMetrics = metrics[model] || metrics.creative;

        // Анимированное обновление показателей
        animateMetric('cpu', modelMetrics.cpu);
        animateMetric('memory', modelMetrics.memory);
        animateMetric('network', modelMetrics.network);
    }

    function animateMetric(type, targetValue) {
        const elements = {
            cpu: document.querySelectorAll('.stat-progress')[0],
            memory: document.querySelectorAll('.stat-progress')[1],
            network: document.querySelectorAll('.stat-progress')[2]
        };

        const element = elements[type];
        if (!element) return;

        let currentValue = parseInt(element.style.width) || 0;
        const step = (targetValue - currentValue) / 30;

        const interval = setInterval(() => {
            currentValue += step;

            if ((step > 0 && currentValue >= targetValue) || (step < 0 && currentValue <= targetValue)) {
                currentValue = targetValue;
                clearInterval(interval);
            }

            element.style.width = currentValue + '%';
            element.nextElementSibling.textContent = Math.round(currentValue) + '%';
        }, 50);
    }

    function startSystemNotifications() {
        const notifications = [
            "Система оптимизирована для работы с большими моделями",
            "Кэш нейросети очищен и перезагружен",
            "Обновлены веса модели для повышения точности",
            "Проведена калибровка параметров генерации"
        ];

        setInterval(() => {
            if (Math.random() > 0.7) {
                const randomNotification = notifications[Math.floor(Math.random() * notifications.length)];
                showNotification(randomNotification, 'info');
            }
        }, 30000);
    }

    function showNotification(message, type = 'info') {
        const notification = document.createElement('div');
        notification.className = `system-notification ${type}`;
        notification.innerHTML = `
            <div class="notification-icon">
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'info-circle'}"></i>
            </div>
            <div class="notification-content">
                <div class="notification-message">${message}</div>
            </div>
            <button class="notification-close">
                <i class="fas fa-times"></i>
            </button>
        `;

        notification.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            padding: 1rem;
            color: white;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 300px;
            z-index: 10000;
            transform: translateX(400px);
            opacity: 0;
            transition: all 0.5s ease;
        `;

        document.body.appendChild(notification);

        setTimeout(() => {
            notification.style.transform = 'translateX(0)';
            notification.style.opacity = '1';
        }, 100);

        const closeBtn = notification.querySelector('.notification-close');
        closeBtn.addEventListener('click', () => {
            notification.style.transform = 'translateX(400px)';
            notification.style.opacity = '0';
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 500);
        });

        setTimeout(() => {
            if (notification.parentNode) {
                notification.style.transform = 'translateX(400px)';
                notification.style.opacity = '0';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 500);
            }
        }, 5000);
    }

    // Глобальные функции
    window.submitForm = function(form) {
        const selectedModel = document.getElementById('selectedModel').value;
        console.log('Отправка запроса модели:', selectedModel);
        return true;
    };
</script>