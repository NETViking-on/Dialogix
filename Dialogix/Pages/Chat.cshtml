@page
@model Dialogix.Pages.ChatModel
@{
    ViewData["Title"] = "ARSU AI Chat - Multi-Model Intelligence Platform";
}

<link rel="stylesheet" href="~/css/chat.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="~/js/chat.js" defer></script>

<div class="ai-platform">
    
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-animation">
                    <div class="logo-orb"></div>
                </div>
                <span class="logo-text">ARSU AI</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <h3 class="nav-title">МОДЕЛИ ИИ</h3>
                <div class="nav-items">
                    <div class="nav-item active" data-model="creative">
                        <i class="fas fa-feather-alt"></i>
                        <span>Creative Writer</span>
                        <div class="nav-badge">v2.3.1</div>
                    </div>
                    <div class="nav-item" data-model="math">
                        <i class="fas fa-square-root-alt"></i>
                        <span>Math Genius</span>
                        <div class="nav-badge">v3.0.4</div>
                    </div>
                    <div class="nav-item" data-model="code">
                        <i class="fas fa-code"></i>
                        <span>Code Assistant</span>
                        <div class="nav-badge">v2.8.2</div>
                    </div>
                    <div class="nav-item" data-model="science">
                        <i class="fas fa-flask"></i>
                        <span>Science Pro</span>
                        <div class="nav-badge">v3.1.0</div>
                    </div>
                    <div class="nav-item" data-model="business">
                        <i class="fas fa-chart-line"></i>
                        <span>Business AI</span>
                        <div class="nav-badge">v2.9.5</div>
                    </div>
                </div>
            </div>
        </nav>

        <div class="sidebar-footer">
            <div class="system-stats">
                <div class="stat-item">
                    <span class="stat-label">Загрузка ЦП</span>
                    <div class="stat-bar">
                        <div class="stat-progress" style="width: 23%"></div>
                    </div>
                    <span class="stat-value">23%</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Память</span>
                    <div class="stat-bar">
                        <div class="stat-progress" style="width: 67%"></div>
                    </div>
                    <span class="stat-value">67%</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Сеть</span>
                    <div class="stat-bar">
                        <div class="stat-progress" style="width: 12%"></div>
                    </div>
                    <span class="stat-value">12%</span>
                </div>
            </div>
        </div>
    </aside>

    <!-- Основной контент -->
    <main class="main-content">
        <!-- Улучшенный хедер -->
        <header class="chat-header">
            <div class="header-content">
                <div class="header-left">
                    <button class="sidebar-toggle" id="sidebarToggle">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="model-info-panel">
                        <div class="current-model-display">
                            <div class="model-avatar" id="modelAvatar">
                                <i class="fas fa-feather-alt"></i>
                            </div>
                            <div class="model-details">
                                <h2 class="model-name" id="modelName">Creative Writer</h2>
                                <div class="model-specs">
                                    <span class="spec">Специализированная модель</span>
                                    <span class="spec-dot">•</span>
                                    <span class="spec">Для творческих задач</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="header-right">
                    <div class="header-controls">
                        <div class="control-group">
                            <button class="control-btn" data-tooltip="Новый чат" id="newChatBtn">
                                <i class="fas fa-plus"></i>
                            </button>
                            <button class="control-btn" data-tooltip="История чатов">
                                <i class="fas fa-history"></i>
                            </button>
                        </div>

                        <div class="system-status">
                            <div class="status-indicators">
                                <div class="status-item online">
                                    <div class="status-dot"></div>
                                    <span>Система онлайн</span>
                                </div>
                                <div class="status-item performance">
                                    <div class="status-dot"></div>
                                    <span>Оптимальная производительность</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="model-loading-bar" id="modelLoadingBar">
                <div class="loading-progress"></div>
                <div class="loading-text">Инициализация нейросети...</div>
            </div>
        </header>

        
        <div class="chat-body" id="chatBody" aria-live="polite">
            <div class="messages" id="messagesList">
                @if (Model.Messages == null || !Model.Messages.Any())
                {
                    <div class="chat-empty">
                        <div class="empty-icon">💬</div>
                        <p>No messages yet. Start a conversation with AI! 👋</p>
                    </div>
                }
                else
                {
                    @foreach (var msg in Model.Messages)
                    {
                        <div class="message @(msg.User == "Bot" ? "bot-message" : "user-message")">
                            <div class="message-avatar">
                                @if (msg.User == "Bot")
                                {
                                    <div class="avatar-bot">
                                        <i class="fas fa-robot"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="avatar-user">
                                        <i class="fas fa-user"></i>
                                    </div>
                                }
                            </div>
                            <div class="message-content">
                                <div class="message-header">
                                    <span class="message-sender">@msg.User</span>
                                    <span class="message-time">@msg.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                                </div>
                                <div class="message-text">@msg.Text</div>
                                <div class="message-footer">
                                    <span class="message-model" id="messageModelTag">Creative Writer</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

       
        <div class="ai-typing-indicator" id="typingIndicator" style="display: none;">
            <div class="typing-avatar">
                <div class="avatar-bot">
                    <i class="fas fa-robot"></i>
                </div>
            </div>
            <div class="typing-content">
                <div class="typing-text">ИИ печатает ответ</div>
                <div class="typing-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>

        
        <footer class="chat-footer">
            <div class="input-container">
               
                <div class="quick-actions">
                    <div class="model-switcher-compact">
                        <button class="model-switch-btn" id="compactModelSwitch">
                            <span id="compactModelIcon">📚</span>
                            <span class="model-switch-text">Creative</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                    </div>
                </div>

               
                <form method="post" class="chat-form" id="chatForm">
                    @Html.AntiForgeryToken()
                    <div class="input-wrapper">
                        <label class="visually-hidden" for="UserInput">Ваше сообщение</label>
                        <input type="text"
                               id="UserInput"
                               name="UserInput"
                               class="chat-input"
                               autocomplete="off"
                               placeholder="Введите ваш запрос..."
                               required />
                    </div>

                    <button type="submit" class="chat-send-btn" id="sendButton">
                        <span class="send-icon">
                            <i class="fas fa-paper-plane"></i>
                        </span>
                        <span class="send-text">Отправить</span>
                    </button>
                </form>
            </div>

            <!-- Статусная строка -->
            <div class="status-bar">
                <div class="status-left">
                    <span class="status-item">
                        <i class="fas fa-database"></i>
                        Модель: <strong id="currentModelStatus">Creative Writer</strong>
                    </span>
                    <span class="status-item">
                        <i class="fas fa-bolt"></i>
                        Задержка: <strong>42ms</strong>
                    </span>
                </div>
                <div class="status-right">
                    <span class="status-item">
                        <i class="fas fa-shield-alt"></i>
                        Безопасность: <strong>активна</strong>
                    </span>
                </div>
            </div>
        </footer>
    </main>
</div>


<div class="modal-overlay" id="modelModal" style="display: none;">
    <div class="modal-container">
        <div class="modal-header">
            <h2>Выбор модели ИИ</h2>
            <button class="modal-close" id="modalClose">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-content">
            <div class="models-grid">
                <div class="model-card active" data-model="creative">
                    <div class="model-card-header">
                        <div class="model-icon creative">
                            <i class="fas fa-feather-alt"></i>
                        </div>
                        <div class="model-badge">РЕКОМЕНДУЕМАЯ</div>
                    </div>
                    <h3 class="model-card-title">Creative Writer</h3>
                    <p class="model-card-desc">Специализированная модель для креативного письма, литературных текстов и творческого контента</p>
                    <div class="model-features">
                        <span class="feature-tag">📝 Креативное письмо</span>
                        <span class="feature-tag">🎭 Литература</span>
                        <span class="feature-tag">✍️ Копирайтинг</span>
                    </div>
                </div>

                <div class="model-card" data-model="math">
                    <div class="model-card-header">
                        <div class="model-icon math">
                            <i class="fas fa-square-root-alt"></i>
                        </div>
                        <div class="model-badge new">НОВАЯ</div>
                    </div>
                    <h3 class="model-card-title">Math Genius</h3>
                    <p class="model-card-desc">Продвинутая математическая модель для решения сложных задач и аналитических вычислений</p>
                    <div class="model-features">
                        <span class="feature-tag">🧮 Математика</span>
                        <span class="feature-tag">📊 Анализ</span>
                        <span class="feature-tag">🔢 Вычисления</span>
                    </div>
                </div>

                <div class="model-card" data-model="code">
                    <div class="model-card-header">
                        <div class="model-icon code">
                            <i class="fas fa-code"></i>
                        </div>
                    </div>
                    <h3 class="model-card-title">Code Assistant</h3>
                    <p class="model-card-desc">Помощник в программировании и разработке программного обеспечения</p>
                    <div class="model-features">
                        <span class="feature-tag">💻 Программирование</span>
                        <span class="feature-tag">🐛 Отладка</span>
                        <span class="feature-tag">⚡ Оптимизация</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn-primary" id="confirmModelSwitch">Применить модель</button>
        </div>
    </div>
</div>

<style>
    
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .ai-platform {
        display: flex;
        height: 100vh;
        background: linear-gradient(135deg, #0c0c0c 0%, #1a1a2e 50%, #16213e 100%);
        font-family: 'Inter', sans-serif;
        overflow: hidden;
        position: relative;
    }

    
    .sidebar {
        width: 280px;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        flex-direction: column;
        z-index: 10;
    }

    .sidebar-header {
        padding: 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .logo-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .logo-animation {
        position: relative;
        width: 40px;
        height: 40px;
    }

    .logo-orb {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        animation: float 3s ease-in-out infinite;
    }

    .logo-text {
        font-size: 1.25rem;
        font-weight: 700;
        background: linear-gradient(135deg, #fff, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .sidebar-nav {
        flex: 1;
        padding: 1rem 0;
    }

    .nav-section {
        margin-bottom: 2rem;
    }

    .nav-title {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.5);
        padding: 0 1.5rem;
        margin-bottom: 0.75rem;
        letter-spacing: 0.05em;
    }

    .nav-items {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1.5rem;
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
    }

        .nav-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.9);
        }

        .nav-item.active {
            background: linear-gradient(90deg, rgba(124, 58, 237, 0.2), transparent);
            color: #fff;
            border-right: 3px solid #7c3aed;
        }

    .nav-badge {
        background: rgba(124, 58, 237, 0.3);
        color: #a78bfa;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 600;
        margin-left: auto;
    }

    .sidebar-footer {
        padding: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .system-stats {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .stat-label {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.6);
        min-width: 60px;
    }

    .stat-bar {
        flex: 1;
        height: 4px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 2px;
        overflow: hidden;
    }

    .stat-progress {
        height: 100%;
        background: linear-gradient(90deg, #10b981, #34d399);
        border-radius: 2px;
        transition: width 0.3s ease;
    }

    .stat-value {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.8);
        min-width: 30px;
        text-align: right;
    }

    /* Основной контент */
    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    
    .chat-header {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1rem 2rem;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .sidebar-toggle {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.7);
        font-size: 1.25rem;
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .sidebar-toggle:hover {
            background: rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.9);
        }

    .model-info-panel {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .current-model-display {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .model-avatar {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .model-details {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .model-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: white;
        margin: 0;
    }

    .model-specs {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.6);
    }

    .spec-dot {
        color: rgba(255, 255, 255, 0.4);
    }

    .header-right {
        display: flex;
        align-items: center;
    }

    .header-controls {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .control-group {
        display: flex;
        gap: 0.5rem;
    }

    .control-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.7);
        padding: 0.5rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

        .control-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.9);
        }

    .system-status {
        display: flex;
        align-items: center;
    }

    .status-indicators {
        display: flex;
        gap: 1rem;
    }

    .status-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.7);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .status-item.online .status-dot {
        background: #10b981;
        box-shadow: 0 0 10px #10b981;
    }

    .status-item.performance .status-dot {
        background: #f59e0b;
        box-shadow: 0 0 10px #f59e0b;
    }

    .model-loading-bar {
        height: 3px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 2px;
        overflow: hidden;
        margin-top: 1rem;
        position: relative;
        display: none;
    }

    .loading-progress {
        height: 100%;
        background: linear-gradient(90deg, #7c3aed, #a78bfa);
        border-radius: 2px;
        animation: loading 2s ease-in-out infinite;
    }

    .loading-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.7);
    }

    /* Основная область сообщений */
    .chat-body {
        flex: 1;
        overflow-y: auto;
        padding: 2rem;
        display: flex;
        flex-direction: column;
    }

    .messages {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .chat-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: rgba(255, 255, 255, 0.7);
        text-align: center;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.7;
    }

    .chat-empty p {
        margin: 0;
        font-size: 1.1rem;
    }

    /* Стили сообщений */
    .message {
        display: flex;
        gap: 1rem;
        animation: messageAppear 0.3s ease;
    }

    .user-message {
        justify-content: flex-end;
    }

    .message-avatar {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
    }

    .avatar-bot, .avatar-user {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .avatar-bot {
        background: linear-gradient(135deg, #7c3aed, #a78bfa);
        color: white;
    }

    .avatar-user {
        background: linear-gradient(135deg, #10b981, #34d399);
        color: white;
    }

    .message-content {
        max-width: 70%;
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 1.25rem;
        position: relative;
    }

    .user-message .message-content {
        background: rgba(124, 58, 237, 0.1);
        border-color: rgba(124, 58, 237, 0.2);
    }

    .message-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .message-sender {
        font-weight: 600;
        color: white;
        font-size: 0.9rem;
    }

    .message-time {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.8rem;
    }

    .message-text {
        color: rgba(255, 255, 255, 0.9);
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .message-footer {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .message-model {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.5);
    }

    /* Индикатор набора */
    .ai-typing-indicator {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
        animation: typingAppear 0.3s ease;
    }

    .typing-avatar {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
    }

    .typing-content {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 1rem 1.5rem;
    }

    .typing-text {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .typing-dots {
        display: flex;
        gap: 0.25rem;
    }

        .typing-dots span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.5);
            animation: typing 1.4s ease-in-out infinite both;
        }

