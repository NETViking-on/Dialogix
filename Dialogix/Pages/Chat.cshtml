@page
@model Dialogix.Pages.ChatModel
@{
    ViewData["Title"] = "Dialogix AI Chat";
}

<link rel="stylesheet" href="~/css/chat.css" />
<script src="~/js/chat.js" defer></script>

<div class="chat-page cyber-ui">
    <header class="chat-header cyber-header">
        <h2><span class="neon-blue">DIALOGIX</span> <span class="neon-pink">AI</span> CHAT</h2>
    </header>

    <main class="chat-body" id="chatBody" aria-live="polite">
        <ul class="messages" id="messagesList">
            @if (Model.Messages == null || !Model.Messages.Any())
            {
                <li class="chat-empty neon-fade">No messages yet. Say hi 👋</li>
            }
            else
            {
                @foreach (var msg in Model.Messages)
                {
                    <li class="message @(msg.User == "Bot" ? "bot" : "user")">
                        <div class="bubble cyber-bubble">
                            <div class="meta">
                                <span class="user">@msg.User</span>
                                <span class="time">@msg.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                            <div class="text">@msg.Text</div>
                        </div>
                    </li>
                }
            }
        </ul>
    </main>

    <form method="post" class="chat-form cyber-form" onsubmit="return submitForm(this);">
        <label class="visually-hidden" for="UserInput">Your message</label>
        <input type="text" id="UserInput" name="UserInput" class="chat-input neon-input" autocomplete="off" placeholder="> Type a message..." />
        <button type="submit" class="chat-send neon-button">SEND ▷</button>
    </form>
</div>
