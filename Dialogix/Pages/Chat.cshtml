@page
@model Dialogix.Pages.ChatModel
@{
    ViewData["Title"] = "Dialogix AI Chat";
}

<link rel="stylesheet" href="~/css/chat.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="~/js/chat.js" defer></script>

<div class="chat-page">
    <header class="chat-header">
        <div class="header-content">
            <h2 class="header-title">
                <span class="brand-gradient">DIALOGIX</span>
                <span class="neon-accent">AI</span>
                CHAT
            </h2>
            <div class="header-info">
                <span class="status-indicator">
                    <span class="pulse-dot"></span>
                    Live
                </span>
            </div>
        </div>
    </header>

    <main class="chat-body" id="chatBody" aria-live="polite">
        <div class="messages" id="messagesList">
            @if (Model.Messages == null || !Model.Messages.Any())
            {
                <div class="chat-empty">
                    <div class="empty-icon">💬</div>
                    <p>No messages yet. Start a conversation with AI! 👋</p>
                </div>
            }
            else
            {
                @foreach (var msg in Model.Messages)
                {
                    <div class="message @(msg.User == "Bot" ? "bot-message" : "user-message")">
                        <div class="bubble">
                            <div class="meta">
                                <span class="user">@msg.User</span>
                                <span class="time">@msg.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                            <div class="text">@msg.Text</div>
                        </div>
                    </div>
                }
            }
        </div>
    </main>

    <form method="post" class="chat-form" onsubmit="return submitForm(this);">
        <div class="input-container">
            <label class="visually-hidden" for="UserInput">Your message</label>
            <input type="text"
                   id="UserInput"
                   name="UserInput"
                   class="chat-input"
                   autocomplete="off"
                   placeholder="Type your message here..."
                   required />
            <button type="submit" class="chat-send">
                <span class="send-icon">🚀</span>
                Send
            </button>
        </div>
    </form>
</div>

<style>
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .header-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: #ffffff;
        text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

    .brand-gradient {
        background: linear-gradient(90deg, #ffffff, #e0e7ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .neon-accent {
        color: #c4b5fd;
        text-shadow: 0 0 15px rgba(196, 181, 253, 0.7);
    }

    .header-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: #c4b5fd;
        font-weight: 500;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #a78bfa;
        animation: pulse 2s infinite;
        box-shadow: 0 0 10px rgba(167, 139, 250, 0.5);
    }

    .input-container {
        display: flex;
        gap: 1rem;
        width: 100%;
    }

    .user-message {
        justify-content: flex-end;
    }

        .user-message .bubble {
            background: rgba(124, 58, 237, 0.1);
            border-color: rgba(124, 58, 237, 0.3);
        }

    .bot-message {
        justify-content: flex-start;
    }

    .empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.7;
    }

    .chat-empty p {
        margin: 0;
        font-size: 1.1rem;
    }

    .send-icon {
        font-size: 1.1em;
    }

    /* ФИОЛЕТОВАЯ ШАПКА */
    .chat-header {
        background: linear-gradient(135deg, #7c3aed, #6d28d9, #5b21b6) !important;
        backdrop-filter: none !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
        box-shadow: 0 4px 20px rgba(124, 58, 237, 0.4) !important;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.7;
            transform: scale(1.1);
        }
    }

    /* Дополнительные стили для контрастности текста */
    .header-title {
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    }

    .status-indicator {
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
</style>