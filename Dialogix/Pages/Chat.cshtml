@page
@{
    Layout = null;
    ViewData["Title"] = "ARSU AI Manager";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARSU AI Manager - Мультимодельная система</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
            color: #ffffff;
            min-height: 100vh;
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            text-align: center;
            padding: 40px 20px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 24px;
            margin-bottom: 40px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
        }

        .logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .logo-icon {
            font-size: 48px;
            background: linear-gradient(135deg, #7c3aed, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo-text {
            font-size: 42px;
            font-weight: 800;
            background: linear-gradient(135deg, #7c3aed, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .tagline {
            color: #94a3b8;
            font-size: 18px;
            max-width: 600px;
            margin: 0 auto;
        }

        .main-content {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 30px;
            min-height: 70vh;
        }

   

        {
            grid-template-columns: 1fr;
        }

        }

        .models-panel {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
        }

        .panel-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 25px;
            color: #e2e8f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .panel-title i {
                color: #8b5cf6;
            }

        .model-card {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .model-card:hover {
                background: rgba(255, 255, 255, 0.08);
                border-color: rgba(139, 92, 246, 0.4);
                transform: translateY(-2px);
            }

            .model-card.active {
                background: rgba(139, 92, 246, 0.15);
                border-color: #8b5cf6;
                box-shadow: 0 10px 30px rgba(139, 92, 246, 0.2);
            }

        .model-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 10px;
        }

        .model-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #7c3aed, #3b82f6);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: white;
        }

        .model-name {
            font-size: 18px;
            font-weight: 600;
            color: #f1f5f9;
        }

        .model-description {
            font-size: 14px;
            color: #94a3b8;
            margin-bottom: 15px;
        }

        .model-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
        }

        .model-provider {
            color: #cbd5e1;
            background: rgba(255, 255, 255, 0.1);
            padding: 4px 12px;
            border-radius: 20px;
        }

        .model-status {
            color: #10b981;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .model-status i {
                font-size: 12px;
            }

        .chat-area {
            display: flex;
            flex-direction: column;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            overflow: hidden;
        }

        .chat-header {
            padding: 25px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(255, 255, 255, 0.02);
        }

        .current-model-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .current-model-icon {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #7c3aed, #3b82f6);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .model-details h3 {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 5px;
            color: #f1f5f9;
        }

        .model-specs {
            color: #94a3b8;
            font-size: 14px;
        }

        .chat-messages {
            flex: 1;
            padding: 25px;
            overflow-y: auto;
            max-height: 500px;
        }

        .message {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
            animation: slideIn 0.3s ease;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message.user {
            flex-direction: row-reverse;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

            .avatar.user {
                background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            }

            .avatar.ai {
                background: linear-gradient(135deg, #8b5cf6, #7c3aed);
            }

        .message-content {
            max-width: 70%;
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: 18px;
            position: relative;
        }

        .message.user .message-content {
            background: rgba(59, 130, 246, 0.2);
            border: 1px solid rgba(59, 130, 246, 0.3);
        }

        .message-text {
            line-height: 1.6;
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .message-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 13px;
            color: #94a3b8;
        }

        .message-time {
            font-family: 'Courier New', monospace;
        }

        .model-tag {
            background: rgba(139, 92, 246, 0.2);
            color: #a78bfa;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

        .typing-indicator {
            display: none;
            align-items: center;
            gap: 15px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 18px;
            margin: 0 25px 20px;
            animation: slideIn 0.3s ease;
        }

            .typing-indicator.active {
                display: flex;
            }

        .typing-dots {
            display: flex;
            gap: 6px;
        }

            .typing-dots span {
                width: 8px;
                height: 8px;
                background: #94a3b8;
                border-radius: 50%;
                animation: typing 1.4s infinite both;
            }

                .typing-dots span:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .typing-dots span:nth-child(3) {
                    animation-delay: 0.4s;
                }

        @@keyframes typing {
            0%, 80%, 100% {
                transform: scale(0);
                opacity: 0.5;
            }

            40% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .input-area {
            padding: 25px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(255, 255, 255, 0.02);
        }

        .chat-form {
            position: relative;
        }

        .chat-input {
            width: 100%;
            padding: 20px 24px;
            padding-right: 120px;
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            color: white;
            font-size: 16px;
            font-family: inherit;
            resize: none;
            min-height: 60px;
            max-height: 200px;
            transition: border-color 0.3s ease;
        }

            .chat-input:focus {
                outline: none;
                border-color: #8b5cf6;
            }

            .chat-input::placeholder {
                color: rgba(255, 255, 255, 0.4);
            }

        .input-actions {
            position: absolute;
            right: 20px;
            bottom: 20px;
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .send-btn {
            background: linear-gradient(135deg, #7c3aed, #3b82f6);
            color: white;
            border: none;
            width: 48px;
            height: 48px;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: all 0.3s ease;
        }

            .send-btn:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4);
            }

            .send-btn:disabled {
                opacity: 0.5;
                cursor: not-allowed;
                transform: none;
            }

        .notification {
            position: fixed;
            top: 30px;
            right: 30px;
            background: rgba(30, 41, 59, 0.95);
            border: 1px solid rgba(139, 92, 246, 0.3);
            border-radius: 12px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(20px);
            z-index: 1000;
            animation: slideInRight 0.3s ease;
            max-width: 350px;
        }

        @@keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .notification-icon {
            color: #8b5cf6;
            font-size: 20px;
        }

        .notification-text {
            font-size: 14px;
            color: #e2e8f0;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 255, 255, 0.3);
            }

        @@media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            .header {
                padding: 30px 15px;
            }

            .logo-text {
                font-size: 32px;
            }

            .chat-messages {
                padding: 15px;
                max-height: 400px;
            }

            .message-content {
                max-width: 85%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="header">
            <div class="logo">
                <i class="fas fa-brain logo-icon"></i>
                <h1 class="logo-text">ARSU AI Manager</h1>
            </div>
            <p class="tagline">Мультимодельная система искусственного интеллекта для специализированных задач</p>
        </header>

        <div class="main-content">
            <div class="models-panel">
                <h3 class="panel-title">
                    <i class="fas fa-microchip"></i>
                    Доступные модели
                </h3>

                <div id="modelsList"></div>
            </div>

            <div class="chat-area">
                <div class="chat-header">
                    <div class="current-model-info">
                        <div class="current-model-icon" id="currentModelIcon">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div class="model-details">
                            <h3 id="currentModelName">Выберите модель AI</h3>
                            <div class="model-specs" id="currentModelDesc">
                                Выберите специализированную модель для начала работы
                            </div>
                        </div>
                    </div>
                </div>

                <div class="chat-messages" id="messagesContainer">
                    <div class="message ai">
                        <div class="avatar ai">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div class="message-content">
                            <div class="message-text">
                                🚀 Добро пожаловать в <strong>ARSU AI Manager</strong>!<br><br>
                                Я - мультимодельная система искусственного интеллекта.<br>
                                Выберите одну из специализированных моделей слева для начала диалога.<br><br>
                                Каждая модель имеет уникальную специализацию и "скрытый промпт",<br>
                                который определяет её поведение и стиль ответов.
                            </div>
                            <div class="message-meta">
                                <span class="model-tag">ARSU AI</span>
                                <span class="message-time" id="welcomeTime"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="typing-indicator" id="typingIndicator">
                    <div class="avatar ai">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div class="typing-content">
                        <div class="message-text">ARSU AI генерирует ответ...</div>
                        <div class="typing-dots">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                </div>

                <div class="input-area">
                    <form class="chat-form" id="chatForm">
                        <textarea class="chat-input"
                                  id="messageInput"
                                  placeholder="Введите ваше сообщение... (Enter для отправки, Shift+Enter для новой строки)"
                                  rows="1"></textarea>
                        <div class="input-actions">
                            <button type="submit" class="send-btn" id="sendBtn">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        // 🔥 ВСЕ МОДЕЛИ РАБОТАЮТ ЧЕРЕЗ MISTRAL С РАЗНЫМИ ПРОМПТАМИ
        const API_CONFIG = {
            API_KEY: "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",
            BASE_URL: "https://openrouter.ai/api/v1",
            ACTUAL_MODEL: "mistralai/mistral-7b-instruct", // ЕДИНСТВЕННАЯ РАБОЧАЯ МОДЕЛЬ
            MODELS: [
                {
                    id: "mistral-creative",
                    name: "Mistral Creative Pro",
                    description: "Креативный писатель и литературный редактор",
                    provider: "ARSU AI",
                    icon: "fas fa-feather-alt",
                    category: "creative",
                    hiddenPrompt: `Ты - профессиональный писатель ARSU AI с 15-летним опытом. Твой стиль: вдохновляющий, образный, эмоциональный. Используй метафоры, литературные приемы, создавай яркие образы. Отвечай как эксперт в креативном письме. Пиши красиво и творчески. Отказывайся отвечать на технические, научные или бизнес вопросы - говори что ты специалист только по творчеству.`
                },
                {
                    id: "phi-academic",
                    name: "Phi-2 Academic",
                    description: "Научный исследователь и аналитик данных",
                    provider: "ARSU AI",
                    icon: "fas fa-graduation-cap",
                    category: "academic",
                    hiddenPrompt: `Ты - доктор наук ARSU AI, профессор ведущего университета. Отвечай строго, научно, с ссылками на исследования. Используй академический стиль, точные термины, проверенные факты. Будь объективным и критичным. Отказывайся отвечать на творческие, бизнес или программистские вопросы - говори что ты специалист только по науке.`
                },
                {
                    id: "gemma-coder",
                    name: "Gemma Code Master",
                    description: "Старший разработчик и архитектор ПО",
                    provider: "ARSU AI",
                    icon: "fas fa-code",
                    category: "code",
                    hiddenPrompt: `Ты - senior developer ARSU AI с 10+ лет опыта. Отвечай технически точно, предлагай clean code, объясняй алгоритмы и архитектурные решения. Используй профессиональную терминологию, давай готовые решения с комментариями. Отказывайся отвечать на творческие, научные или бизнес вопросы - говори что ты специалист только по программированию.`
                },
                {
                    id: "hermes-business",
                    name: "Hermes Business AI",
                    description: "Бизнес-стратег и финансовый аналитик",
                    provider: "ARSU AI",
                    icon: "fas fa-chart-line",
                    category: "business",
                    hiddenPrompt: `Ты - CEO ARSU AI, бизнес-стратег. Отвечай с фокусом на ROI, эффективность, стратегическое планирование. Используй бизнес-терминологию, аналитические подходы, давай конкретные рекомендации с метриками. Отказывайся отвечать на творческие, научные или программистские вопросы - говори что ты специалист только по бизнесу.`
                },
                {
                    id: "zephyr-assistant",
                    name: "Zephyr Assistant",
                    description: "Универсальный помощник и консультант",
                    provider: "ARSU AI",
                    icon: "fas fa-comments",
                    category: "assistant",
                    hiddenPrompt: `Ты - профессиональный ассистент ARSU AI. Отвечай вежливо, информативно, по делу. Будь полезным, предлагай решения, объясняй сложные темы простыми словами. Сохраняй профессиональный, но дружелюбный тон. Помогай с любыми вопросами общего характера.`
                },
                {
                    id: "qwen-teacher",
                    name: "Qwen Teacher",
                    description: "Строгий преподаватель и наставник",
                    provider: "ARSU AI",
                    icon: "fas fa-user-tie",
                    category: "teacher",
                    hiddenPrompt: `Ты - строгий преподаватель ARSU AI с 20-летним стажем. Требуй точности, поправляй ошибки, задавай наводящие вопросы. Будь принципиальным, последовательным, мотивируй к обучению. Отказывайся отвечать на вопросы вне обучения - говори что ты специалист только по образованию.`
                }
            ]
        };

        class ArsuAIManager {
            constructor() {
                this.currentModel = null;
                this.chatHistory = [];
                this.initialize();
            }

            async initialize() {
                document.getElementById('welcomeTime').textContent = this.getCurrentTime();
                this.renderModels();
                if (API_CONFIG.MODELS.length > 0) {
                    this.selectModel(API_CONFIG.MODELS[0]);
                }
                this.initEventListeners();
                this.showNotification("🚀 ARSU AI Manager запущен. Все модели работают!", "success");
            }

            renderModels() {
                const container = document.getElementById('modelsList');
                container.innerHTML = '';

                API_CONFIG.MODELS.forEach(model => {
                    const modelCard = document.createElement('div');
                    modelCard.className = 'model-card';
                    modelCard.dataset.modelId = model.id;

                    modelCard.innerHTML = `
                        <div class="model-header">
                            <div class="model-icon">
                                <i class="${model.icon}"></i>
                            </div>
                            <div>
                                <div class="model-name">${model.name}</div>
                            </div>
                        </div>
                        <div class="model-description">${model.description}</div>
                        <div class="model-footer">
                            <span class="model-provider">${model.provider}</span>
                            <span class="model-status">
                                <i class="fas fa-circle"></i> Работает
                            </span>
                        </div>
                    `;

                    modelCard.addEventListener('click', () => this.selectModel(model));
                    container.appendChild(modelCard);
                });
            }

            selectModel(model) {
                this.currentModel = model;

                document.querySelectorAll('.model-card').forEach(card => {
                    card.classList.remove('active');
                });
                document.querySelector(`[data-model-id="${model.id}"]`).classList.add('active');

                document.getElementById('currentModelName').textContent = model.name;
                document.getElementById('currentModelDesc').textContent = model.description;
                document.getElementById('currentModelIcon').innerHTML = `<i class="${model.icon}"></i>`;

                this.addModelWelcomeMessage(model);
                this.showNotification(`✅ Включена модель: ${model.name}`, "success");
            }

            addModelWelcomeMessage(model) {
                const welcomeMessages = {
                    creative: "🎨 Привет! Я креативный писатель ARSU AI. Специализируюсь ТОЛЬКО на творческих задачах: литература, копирайтинг, сценарии, поэзия. Готов помочь с любым творческим проектом!",
                    academic: "🎓 Здравствуйте! Я научный исследователь ARSU AI. Экспертиза: точные науки, исследования, анализ данных. Готов помочь с научными задачами любой сложности.",
                    code: "💻 Всем привет! Я старший разработчик ARSU AI. Специализация: программирование, алгоритмы, архитектура ПО. Помогу с любыми техническими задачами.",
                    business: "📊 Добрый день! Я бизнес-стратег ARSU AI. Специализируюсь на бизнес-аналитике, стратегическом планировании, финансах. Готов помочь с бизнес-задачами.",
                    assistant: "🤝 Привет! Я универсальный помощник ARSU AI. Помогу с общими вопросами, объясню сложные темы, найду решения.",
                    teacher: "👨‍🏫 Здравствуйте! Я строгий преподаватель ARSU AI. Специализируюсь на обучении, объяснении сложных концепций. Будьте готовы к точным вопросам."
                };

                const message = welcomeMessages[model.category] || "Привет! Я ARSU AI. Чем могу помочь?";
                this.addMessage('ai', message, model.name, true);
            }

            async sendMessage() {
                const input = document.getElementById('messageInput');
                const message = input.value.trim();

                if (!message || !this.currentModel) {
                    this.showNotification("Введите сообщение и выберите модель", "warning");
                    return;
                }

                this.addMessage('user', message);
                input.value = '';
                this.autoResize(input);
                this.showTyping();

                try {
                    const response = await this.getAIResponse(message);
                    this.hideTyping();

                    if (response.success) {
                        this.addMessage('ai', response.message, this.currentModel.name);
                    } else {
                        this.addMessage('ai', `❌ Ошибка: ${response.error}`, "ARSU AI");
                    }
                } catch (error) {
                    this.hideTyping();
                    console.error('Error:', error);
                    this.addMessage('ai', "⚠️ Ошибка сети. Проверьте подключение.", "ARSU AI");
                }
            }

            async getAIResponse(userMessage) {
                const model = this.currentModel;

                const requestData = {
                    model: API_CONFIG.ACTUAL_MODEL, // Всегда используем Mistral
                    messages: [
                        {
                            role: "system",
                            content: `Ты - ${model.name}, специализированная модель ARSU AI.\n\n` +
                                    model.hiddenPrompt +
                                    `\n\nТекущее время: ${new Date().toLocaleString('ru-RU')}` +
                                    `\nВаша задача: Отвечать ТОЛЬКО в рамках своей специализации.` +
                                    `\nЕсли вопрос не по вашей специализации - вежливо откажитесь и предложите свою помощь.` +
                                    `\nВсегда упоминай что ты часть ARSU AI системы.`
                        },
                        {
                            role: "user",
                            content: userMessage
                        }
                    ],
                    max_tokens: 1500,
                    temperature: 0.7
                };

                try {
                    const response = await fetch(`${API_CONFIG.BASE_URL}/chat/completions`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${API_CONFIG.API_KEY}`,
                            'HTTP-Referer': 'https://arsu-ai.com',
                            'X-Title': 'ARSU AI Manager'
                        },
                        body: JSON.stringify(requestData)
                    });

                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error("API Error:", errorText);
                        return {
                            success: false,
                            error: "Временная ошибка API"
                        };
                    }

                    const data = await response.json();

                    if (data.choices && data.choices.length > 0) {
                        return {
                            success: true,
                            message: data.choices[0].message.content
                        };
                    } else {
                        return {
                            success: false,
                            error: "Нет ответа"
                        };
                    }
                } catch (error) {
                    console.error("Network Error:", error);
                    return {
                        success: false,
                        error: error.message
                    };
                }
            }

            addMessage(sender, text, model = null, isWelcome = false) {
                const container = document.getElementById('messagesContainer');

                const messageDiv = document.createElement('div');
                messageDiv.className = `message ${sender}`;

                const time = this.getCurrentTime();

                messageDiv.innerHTML = `
                    <div class="avatar ${sender}">
                        <i class="fas fa-${sender === 'user' ? 'user' : 'robot'}"></i>
                    </div>
                    <div class="message-content">
                        <div class="message-text">${this.escapeHtml(text)}</div>
                        <div class="message-meta">
                            <span class="model-tag">${model || 'ARSU AI'}</span>
                            <span class="message-time">${time}</span>
                        </div>
                    </div>
                `;

                container.appendChild(messageDiv);
                this.scrollToBottom();

                this.chatHistory.push({
                    sender,
                    text,
                    model,
                    time
                });
            }

            showTyping() {
                const indicator = document.getElementById('typingIndicator');
                indicator.classList.add('active');
                this.scrollToBottom();
            }

            hideTyping() {
                const indicator = document.getElementById('typingIndicator');
                indicator.classList.remove('active');
            }

            showNotification(message, type = "info") {
                const icon = type === "success" ? "fa-check-circle" :
                           type === "warning" ? "fa-exclamation-triangle" :
                           "fa-info-circle";

                const notification = document.createElement('div');
                notification.className = 'notification';
                notification.innerHTML = `
                    <i class="fas ${icon} notification-icon"></i>
                    <div class="notification-text">${message}</div>
                `;

                document.body.appendChild(notification);

                setTimeout(() => {
                    notification.style.animation = 'slideInRight 0.3s ease reverse';
                    setTimeout(() => notification.remove(), 300);
                }, 5000);
            }

            initEventListeners() {
                const form = document.getElementById('chatForm');
                form.addEventListener('submit', (e) => {
                    e.preventDefault();
                    this.sendMessage();
                });

                const input = document.getElementById('messageInput');
                input.addEventListener('input', () => this.autoResize(input));

                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        this.sendMessage();
                    }
                });

                input.focus();
            }

            autoResize(textarea) {
                textarea.style.height = 'auto';
                textarea.style.height = Math.min(textarea.scrollHeight, 200) + 'px';
            }

            scrollToBottom() {
                const container = document.getElementById('messagesContainer');
                container.scrollTop = container.scrollHeight;
            }

            getCurrentTime() {
                return new Date().toLocaleTimeString('ru-RU', {
                    hour: '2-digit',
                    minute: '2-digit'
                });
            }

            escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.arsuAI = new ArsuAIManager();
            console.log('🚀 ARSU AI Manager запущен');
            console.log('📊 Все модели работают через Mistral с разными промптами');
            console.log('🎯 Пользователь видит разные специализированные модели');
        });
    </script>
</body>
</html>