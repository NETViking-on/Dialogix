@page
@model Dialogix.Pages.ProfileModel
@{
    ViewData["Title"] = "User Profile";
}

<link rel="stylesheet" href="~/css/profile.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="profile-page">
    <!-- Уведомления -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="profile-container">
        <!-- Заголовок профиля -->
        <div class="profile-header">
            <div class="header-content">
                <div class="avatar-section">
                    <div class="avatar-large">
                        <span class="avatar-initials">@GetInitials(Model.Username)</span>
                    </div>
                    <div class="user-basic-info">
                        <h1 class="username">@Model.Username</h1>
                        <p class="user-email">@Model.Email</p>
                        <p class="member-since">Member since @Model.MemberSince.ToString("MMMM yyyy")</p>
                    </div>
                </div>
                <div class="header-actions">
                    <form method="post" asp-page-handler="ExportData">
                        <button type="submit" class="btn btn-export">
                            <span class="icon">📥</span> Export Data
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="profile-content">
            <!-- Левая колонка - Информация и настройки -->
            <div class="left-column">
                <!-- Карточка профиля -->
                <div class="profile-card">
                    <h3 class="card-title">Profile Information</h3>
                    <form method="post" asp-page-handler="UpdateProfile">
                        <div class="form-group">
                            <label for="DisplayName">Display Name</label>
                            <input type="text" id="DisplayName" asp-for="ProfileUpdate.DisplayName"
                                   class="form-input" placeholder="Enter display name" value="@Model.Username" />
                            <span asp-validation-for="ProfileUpdate.DisplayName" class="validation-error"></span>
                        </div>
                        <div class="form-group">
                            <label for="Bio">Bio</label>
                            <textarea id="Bio" asp-for="ProfileUpdate.Bio" class="form-textarea"
                                      placeholder="Tell us about yourself..." rows="4"></textarea>
                            <span asp-validation-for="ProfileUpdate.Bio" class="validation-error"></span>
                        </div>
                        <button type="submit" class="btn btn-primary btn-save">Save Changes</button>
                    </form>
                </div>

                <!-- Статистика сообщений -->
                <div class="stats-card">
                    <h3 class="card-title">Message Statistics</h3>
                    <div class="stats-grid">
                        <div class="stat-item">
                            <div class="stat-value">@Model.TotalMessages</div>
                            <div class="stat-label">Total Messages</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">@Model.TodayMessages</div>
                            <div class="stat-label">Today</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">@Model.ThisWeekMessages</div>
                            <div class="stat-label">This Week</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">@Model.ThisMonthMessages</div>
                            <div class="stat-label">This Month</div>
                        </div>
                    </div>
                </div>

                <!-- Аналитика -->
                <div class="analytics-card">
                    <h3 class="card-title">Analytics</h3>
                    <div class="analytics-list">
                        <div class="analytic-item">
                            <span class="label">Average Message Length:</span>
                            <span class="value">@Model.AverageMessageLength chars</span>
                        </div>
                        <div class="analytic-item">
                            <span class="label">Most Active Day:</span>
                            <span class="value">@Model.MostActiveDay</span>
                        </div>
                        <div class="analytic-item">
                            <span class="label">Most Active Hour:</span>
                            <span class="value">@Model.MostActiveHour</span>
                        </div>
                        <div class="analytic-item">
                            <span class="label">Longest Conversation:</span>
                            <span class="value">@Model.LongestConversation messages</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Правая колонка - Графики и активность -->
            <div class="right-column">
                <!-- Достижения -->
                <div class="achievements-card">
                    <div class="card-header">
                        <h3 class="card-title">Achievements</h3>
                        <div class="progress-circle">
                            <div class="progress-text">@Model.AchievementProgress%</div>
                        </div>
                    </div>
                    <div class="achievements-grid">
                        @foreach (var achievement in Model.Achievements)
                        {
                            <div class="achievement-item @(achievement.IsUnlocked ? "unlocked" : "locked")">
                                <div class="achievement-icon">@achievement.Icon</div>
                                <div class="achievement-info">
                                    <div class="achievement-name">@achievement.Name</div>
                                    <div class="achievement-desc">@achievement.Description</div>
                                    <div class="achievement-progress">
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: @achievement.Progress%"></div>
                                        </div>
                                        <span class="progress-text">@achievement.Progress%</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Активность по дням -->
                <div class="activity-card">
                    <h3 class="card-title">7-Day Activity</h3>
                    <div class="activity-chart">
                        @foreach (var day in Model.MessagesPerDay)
                        {
                            <div class="chart-bar">
                                <div class="bar-value">@day.Value</div>
                                <div class="bar-container">
                                    <div class="bar-fill" style="height: @(Math.Min(day.Value * 10, 100))%"></div>
                                </div>
                                <div class="bar-label">@day.Key</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Почасовая активность -->
                <div class="hourly-card">
                    <h3 class="card-title">Hourly Activity</h3>
                    <div class="hourly-chart">
                        @foreach (var hour in Model.HourlyActivity)
                        {
                            <div class="hour-item">
                                <div class="hour-label">@hour.Key</div>
                                <div class="hour-bar-container">
                                    <div class="hour-bar" style="width: @(Math.Min(hour.Value * 5, 100))%"></div>
                                </div>
                                <div class="hour-value">@hour.Value</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Недавние сообщения -->
                <div class="recent-activity-card">
                    <h3 class="card-title">Recent Activity</h3>
                    <div class="messages-list">
                        @if (Model.RecentMessages.Any())
                        {
                            foreach (var message in Model.RecentMessages)
                            {
                                <div class="message-item">
                                    <div class="message-meta">
                                        <span class="message-sender">@message.User</span>
                                        <span class="message-time">@message.CreatedAt.ToString("HH:mm")</span>
                                    </div>
                                    <div class="message-text">@message.Text</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <p>No messages yet. Start chatting to see your activity!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}"
            : $"{char.ToUpper(name[0])}";
    }
}