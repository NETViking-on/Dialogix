<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ARSU AI MANAGER</title>


    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dialogix.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />


    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <img src="@Url.Content("~/Images/ZhubanovLogo.png")" alt="Zhubanov University" class="navbar-logo me-2" />
                    ARSU AI MANAGER
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Chat">Chat</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex justify-content-between align-items-center flex-wrap">
            <div>
                &copy; 2025 - ARSU AI MANAGER - <a asp-area="" asp-page="/Privacy">Privacy</a>
            </div>
            <div class="footer-contacts d-flex gap-3 align-items-center">
                <span>📧 <a href="mailto:ilyaprogrammer10@gmail.com">ilyaprogrammer10@gmail.com</a></span>
                <span>
                    <a href="https://github.com/NETViking-on" target="_blank">
                        <img src="@Url.Content("~/Images/github-icon.png")" alt="GitHub" class="github-icon"> GitHub
                    </a>
                </span>
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    .navbar-logo {
        height: 40px;
        width: auto;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .navbar-brand:hover .navbar-logo {
        transform: scale(1.05);
    }

   
    @@media (max-width: 576px) {
        .navbar-logo {
            height: 32px;
        }

        .navbar-brand {
            font-size: 0.9rem;
        }
    }
</style>