{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "AppSettings": {
    "ApplicationName": "Dialogix",
    "Version": "1.0.0"
  },

  "JwtSettings": {
    "Secret": "PLACEHOLDER_FOR_PRODUCTION_SECRET",
    "Issuer": "DialogixAPI",
    "Audience": "DialogixUsers",
    "ExpiryMinutes": 60
  },

  "Cors": {
    "AllowedOrigins": [ "https://localhost:5001" ]
  }
}
